# À copier en .env (dans le même dossier que docker-compose.yml).

# Adresse IP du NAS sur le réseau local.
NAS_ADRESSE=192.168.1.10

# Jeton d'API Mealie : Mealie → Profil → Jetons d'API (page /user/profile/api-tokens).
# Laisser vide au premier démarrage, puis le renseigner et relancer le projet.
MEALIE_JETON=

# Nombre de jours de planning repris dans le menu de la 3DS.
MENU_JOURS=7

# Utilisateur sous lequel tourne Mealie dans le conteneur.
PUID=1026
PGID=100
